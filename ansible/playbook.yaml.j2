    - name: Print message
      ansible.builtin.debug:
        msg: Hello world





{% if grains.get('use_avahi') and grains.get('avahi_reflector') %}

- name: reflector configuration
  hosts: minion

  tasks:
    - name: Enable reflector in config
      ansible.builtin.replace:
        path: /etc/avahi/avahi-daemon.conf
        regexp: "#enable-reflector=no"
        replace: "enable-reflector=yes"
      notify: avahi-daemon

    - name: Ensure avahi-daemon is running
      ansible.builtin.service:
        name: avahi-daemon
        enabled: true
        state: started

  handlers:
    - name: avahi-daemon
      ansible.builtin.service:
        name: avahi-daemon
        state: started
        enabled: true

{% endif %}
